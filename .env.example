# Timezone
TZ=Asia/Taipei

# Docker image (leave blank to use default)
# HERMES_IMAGE=nousresearch/hermes-agent:latest

# Data directory on host
# HERMES_DATA_DIR=~/.hermes

# Ports
# HERMES_GATEWAY_PORT=8642
# HERMES_DASHBOARD_PORT=9119

# Resource limits
# HERMES_MEMORY_LIMIT=4G
# HERMES_CPU_LIMIT=2.0

# Gateway URL for dashboard health check
# Only change if gateway is on a different host
# GATEWAY_HEALTH_URL=http://hermes:8642
# GATEWAY_HEALTH_TIMEOUT=3

# API Keys (written to ~/.hermes/.env by setup wizard)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
