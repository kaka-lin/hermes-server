# 其他 home 的 Compose 設定範本。一般不用手寫：`./hermes-run.sh new <名稱>` 會產生
# agents/<名稱>.conf 並自動挑好 port。真檔被 agents/.gitignore 忽略。
#
# 這裡只管容器怎麼起（data dir、容器名、port、image 版本）；Hermes 自己的設定
# 在 data dir 裡的 .env 與 config.yaml。

# 掛到容器 /opt/data 的資料夾；${HOME} 會在 hermes-run.sh 讀這個檔時展開
HERMES_DATA_DIR=${HOME}/.hermes-<名稱>

# 容器名稱，全機唯一
HERMES_CONTAINER_NAME=hermes-<名稱>

# 對外 port，不能和其他 home 或 browsers.conf 的 CDP port 重複
HERMES_GATEWAY_PORT=8643
HERMES_DASHBOARD_PORT=9120

# （可不寫）這個 home 的 image 版本；不寫就用 compose.env 的 HERMES_VERSION。
# HERMES_VERSION=v0.23.1
