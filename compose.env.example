# Docker Compose variables for this repo. Copy to compose.env (not committed).
# hermes-build.sh and hermes-run.sh pass it to Compose with --env-file.
# Hermes runtime secrets do not belong here; they live in <data dir>/.env.

# Image: the custom image is <HERMES_IMAGE>:<HERMES_VERSION>, built on
# nousresearch/hermes-agent:<HERMES_VERSION>. Rebuild after changing any of these.
HERMES_IMAGE=kakalin/hermes-agent
HERMES_VERSION=v0.23.1
AGENT_BROWSER_VERSION=0.26.0
