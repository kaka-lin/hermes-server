+            # EPERM is how older Docker Desktop file sharing (4.41) refuses the socket; never a live sibling.
+            stale_inode = exc.errno == errno.EADDRINUSE and not os.path.lexists(bind_path)
+            refused = exc.errno in _SOCKET_UNSUPPORTED_ERRNOS or exc.errno == errno.EPERM or stale_inode
+            if pointer_file is not None or not refused:
                 raise
             logger.warning("Control socket cannot be created in %s (%s); listening in a private temp directory",
                            self._home, exc.strerror or exc)
