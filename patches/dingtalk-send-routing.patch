+    async def _send_via_robot_api(self, chat_id: str, content: str) -> SendResult:
+        """Group delivery when no session webhook is known (cron output, explicit ``dingtalk:cid...`` targets)."""
+        token = await self._get_access_token()
+        if not token:
+            return SendResult(success=False, error="No valid session_webhook and no access token for the robot API")
+        try:
+            delivered = await _robot_api_send(self._http_client, token, self._robot_code, chat_id,
+                                              self._normalize_markdown(content[: self.MAX_MESSAGE_LENGTH]))
+        except Exception as e:
+            logger.error("[%s] Robot API send error: %s", self.name, e)
+            return SendResult(success=False, error=f"Robot API send failed: {e}")
+        if delivered:
+            logger.info("[%s] Delivered via robot API to %s", self.name, chat_id)
+            return SendResult(success=True, message_id=uuid.uuid4().hex[:12])
+        return SendResult(success=False, error="Robot API returned no processQueryKey")
