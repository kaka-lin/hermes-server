+def _parse_target_ref(target_ref: str):
+    """Every non-empty target is adapter-native and explicit (``cid...`` groups, staff ids alike).
+
+    Without this parser a ``dingtalk:cidXXXX==`` target is not recognised as explicit, so the send falls
+    back to ``DINGTALK_HOME_CHANNEL`` and silently lands in the wrong group. Registering a parser also
+    switches the plugin to strict resolution, so accepting everything (like wecom/ntfy) keeps non-group
+    ids reaching the adapter as before.
+    """
+    ref = (target_ref or "").strip()
+    return (ref, None) if ref else None
+
+
+async def _robot_api_send(client: "httpx.AsyncClient", access_token: str, robot_code: str, open_conversation_id: str, message: str) -> bool:
+    """Deliver ``message`` to one group via the official robot API (``robot/groupMessages/send``).
+
+    Session webhooks exist only after an inbound message and expire, and the static custom-robot webhook is
+    bound to a single group, so this is the only path that can address an arbitrary ``cid...`` group (cron
+    reports, explicit ``dingtalk:cid...`` targets). Returns True only when DingTalk acknowledges with a
+    ``processQueryKey``; a 200 with a logical error body counts as failure so callers can fall back.
+    """
+    # msgParam is capped at 15000 *bytes*; ensure_ascii=False keeps CJK at 3 bytes instead of the 6 a
+    # \uXXXX escape costs, which otherwise pushes a short report past the limit and 400s the send.
+    msg_param = json.dumps({"title": "Hermes", "text": message}, ensure_ascii=False)
+    logger.info("DingTalk robot API msgParam: %d bytes (limit 15000)", len(msg_param.encode("utf-8")))
+    resp = await client.post(
+        "https://api.dingtalk.com/v1.0/robot/groupMessages/send",
+        headers={"x-acs-dingtalk-access-token": access_token},
+        json={"robotCode": robot_code, "openConversationId": open_conversation_id, "msgKey": "sampleMarkdown", "msgParam": msg_param},
+        timeout=15.0,
+    )
+    resp.raise_for_status()
+    return bool(resp.json().get("processQueryKey"))
 
 
