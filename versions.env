# 建置版本旋鈕（單一真相來源，git 追蹤）。升級：改這裡、commit、./hermes-build.sh。
# docker-compose.yml / Dockerfile 內的同名預設僅為「直接 docker compose build」的
# 備援，請與此檔保持一致。相容性與升級決策見 docs/guides/agent-browser-versions.md。

# 上游 base image tag（nousresearch/hermes-agent）
HERMES_VERSION=v2026.6.5

# agent-browser 版本（上游刻意 pin ^0.26.0，衍生 image 覆寫成這個版本）
AGENT_BROWSER_VERSION=0.36.0
