# Image version configuration. Copy this file to versions.env in this repo.
# It is intentionally separate from .env.example, which configures Hermes
# runtime secrets at ~/.hermes/.env.

# The upstream base image and resulting custom image tag. Rebuild before using
# a different tag.
HERMES_VERSION=v2026.9.14

# Installed into the custom image at build time. Rebuild after changing it.
AGENT_BROWSER_VERSION=0.26.0
